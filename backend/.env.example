MONGO_URI=
JWT_SECRET=
CURRENCY_CACHE_SECONDS=
PORT=

# Leverantörens bas-URL, inklusive /v1 och utan snedstreck på slutet
SUPPLIER_API_URL=https://leverantor-api.vercel.app/v1
# API-nyckel från leverantörens dokumentation (skickas som headern X-Api-Key)
SUPPLIER_API_KEY=
# Vilken bransch katalogen hämtas för, t.ex. bemanning, bas är klader
SUPPLIER_BRANSCH=bemanning
# Timeout för anrop till leverantören, i millisekunder
SUPPLIER_API_TIMEOUT_MS=5000
SUPPLIER_CACHE_SECONDS=